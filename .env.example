# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (multi-tenant)
DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agentdb

# Async workers
REDIS_URL=redis://localhost:6379/0
# true = webhook processes the lead synchronously (no Redis/worker needed).
# false = enqueue to Celery; run a worker to consume the queue.
PROCESS_INLINE=true

# LLM (provider-agnostic client). Blank ANTHROPIC_API_KEY = offline heuristic fit.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CRM adapter. "mock" works offline; "hubspot" needs a token and hits the real API.
CRM_PROVIDER=mock
HUBSPOT_ACCESS_TOKEN=

# Auth
JWT_SECRET=dev-only-change-me
